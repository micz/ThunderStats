  "ImportantInfoTitle": {
    "message": "Important Information",
    "description": ""
  },
  "ImportantInfoSubtitle_1": {
    "message": "Filter duplicate messages",
    "description": ""
  },
  "ImportantInfoText_1": {
    "message": "Some email providers, such as Gmail, have an \"Archive\" folder that contains all messages. However, the same messages are also present in individual folders. Considering the \"Archive\" folders in the statistics could lead to counting them twice.",
    "description": ""
  },
  "ImportantInfoText_1b": {
    "message": "On the advanced options page, you can choose how to manage these accounts. If an account has a \"gmail.com\" address, it will be set up correctly; otherwise, you will have to set it up manually.",
    "description": ""
  },
  "ImportantInfoSubtitle_2": {
    "message": "Help translate",
    "description": ""
  },
  "ImportantInfoText_2": {
    "message": "If you want to help translate ThunderStats into a new language or improve an existing translation, you can do so! Your contributions are invaluable in making this addon accessible to a wider audience.",
    "description": ""
  },
  "ImportantInfoText_2b": {
    "message": "  Find out how clicking here!",
    "description": ""
