  "OtherInfoText_1": {
    "message": "All the statistics are calculated from the mails that are in the Thunderbird folders, associated with the mail addresses of the selected account.",
    "description": ""
  },
  "OtherInfoText_2b": {
    "message": "The statistics will be updated as soon as Thunderbird has updated the folders from the mail server.",
