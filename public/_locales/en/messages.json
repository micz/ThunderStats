  "ImportantInfoSubtitle_1": {
    "message": "Filter duplicate messages",
    "description": ""
  },
  "ImportantInfoText_1": {
    "message": "Providers like Gmail keep every message in an Archive folder as well as in its own folder, so counting archives can double your numbers. Exclude archives, or keep them and filter duplicates — slower, but more accurate.",
    "description": ""
  },
  "ImportantInfoText_1b": {
    "message": "On the advanced options page, you can choose how to manage these accounts. If an account has a \"gmail.com\" address, it will be set up correctly; otherwise, you will have to set it up manually.",
    "description": ""
  },
  "ImportantInfoSubtitle_2": {
    "message": "Help translate",
    "description": ""
  },
  "ImportantInfoText_2": {
